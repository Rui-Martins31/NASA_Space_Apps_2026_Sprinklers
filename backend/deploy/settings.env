# Deployment settings, read by deploy.sh and by the PowerShell steps in README.md.
# Committed and shared with the team: settings only, NEVER secrets.
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# An environment variable with the same name overrides a line for one run.

# Google Cloud project id. Empty = the one from `gcloud config set project`.
GCP_PROJECT=

GCP_REGION=europe-west1

# Artifact Registry repository that stores the images.
GCP_REPOSITORY=firecal

# Cloud Run service name.
GCP_SERVICE=firecal-backend

# Data the backend serves: mock (test/mock_data) or database.
BACKEND_DATA=mock

# Memory per instance; the mock data takes ~600 MB.
GCP_MEMORY=1Gi

# Most instances Cloud Run may start; caps the bill if traffic spikes.
GCP_MAX_INSTANCES=2
